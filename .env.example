# Set this to your PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://postgres:password@localhost:5432/afyamtoto_ai?schema=public"
# Existing MySQL connection. Required only for the reviewed one-time import.
MYSQL_URL="mysql://user:password@localhost:3306/child_health_platform"
# Optional; required only when the PostgreSQL database has no administrator. Remove after bootstrap.
AFYA_ADMIN_SETUP_SECRET=""
# Optional; one-time credential recovery for the sole existing administrator. Generate randomly and remove after recovery.
AFYA_ADMIN_RECOVERY_SECRET=""
# Optional password reset delivery through Resend. Set the public site URL and a verified sender.
APP_URL="http://localhost:3000"
AUTH_EMAIL_FROM="AFYAMTOTO AI <noreply@example.org>"
RESEND_API_KEY=""
