RewriteEngine On

# Forward legacy PHP URLs to the Next.js application on port 3000.
RewriteRule ^$ http://127.0.0.1:3000/ [R=302,L,NE]
RewriteRule ^index\.php$ http://127.0.0.1:3000/ [R=302,L,NE]
RewriteRule ^public/index\.php$ http://127.0.0.1:3000/ [R=302,L,NE]
RewriteRule ^pages/connexion-administrateur\.php$ http://127.0.0.1:3000/login [R=302,L,NE]
RewriteRule ^pages/(connexion|connexion-agent)\.php$ http://127.0.0.1:3000/login?scope=public [R=302,L,NE]
RewriteRule ^pages/inscription-parent\.php$ http://127.0.0.1:3000/register [R=302,L,NE]
RewriteRule ^pages/(espace-[^/]+|gestion-[^/]+|vaccinations)\.php$ http://127.0.0.1:3000/dashboard [R=302,L,NE]
RewriteRule ^pages/deconnexion\.php$ http://127.0.0.1:3000/logout [R=302,L,NE]
RewriteRule ^pages/(mot-de-passe-oublie|reinitialiser-mot-de-passe)\.php$ http://127.0.0.1:3000/login?scope=public [R=302,L,NE]
RewriteRule ^pages/(plateforme|approche|contact)\.php$ http://127.0.0.1:3000/ [R=302,L,NE]
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [R=302,L,NE]
