{
  "name": "afyamtoto-ai-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "dev": "next dev --hostname 127.0.0.1",
    "build:php-ui": "vite build --config vite.php-ui.config.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:security": "node --experimental-strip-types --test tests/security/rbac-policy.test.mjs",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:import:mysql": "node scripts/migrate-mysql-to-postgres.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.10.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}